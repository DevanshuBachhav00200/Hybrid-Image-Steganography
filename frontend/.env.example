# Hybrid Image Steganography System - Frontend Environment Configuration
# Duplicate this file to .env.local for local environment overrides.

# Fast API Backend Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Branding
NEXT_PUBLIC_APP_NAME="Hybrid Image Steganography System"
NEXT_PUBLIC_APP_VERSION="2.0.0-Enterprise"

# Environment Mode (development | staging | production)
NEXT_PUBLIC_ENVIRONMENT=development
